# Server configuration
[server]
port = 1357
host = "0.0.0.0"
# Public URL for install scripts (used in curl commands)
# NOTE: public_url 必须配置，否则脚本接口将返回 503
# Examples:
#   public_url = "http://yourip:1357"      # Direct IP
#   public_url = "https://mirror.example.com"       # Domain with HTTPS
# If not set, install scripts will return 503
# public_url = "http://yourip:1357"

# Cache settings
[cache]
dir = "./cache"
# 设为 0 表示只保留 tag 引用的版本（例如 stable/latest）
max_versions = 10

# Storage settings (local / oss / s3)
[storage]
# local / oss / s3
mode = "local"

# OSS 配置（当 mode = "oss" 时生效）
[storage.oss]
# endpoint 例：oss-cn-hangzhou.aliyuncs.com
endpoint = ""
bucket = ""
access_key_id = ""
access_key_secret = ""
# 可选：STS 临时凭证
# security_token = ""
# 可选：对象前缀，例如 "mirror"
prefix = ""
https = true
# 是否使用 path-style（https://endpoint/bucket/key）
path_style = false
# 预签名链接过期时间（秒）
expires_seconds = 900

# S3/R2 配置（当 mode = "s3" 时生效）
[storage.s3]
# R2 endpoint 例：https://<ACCOUNT_ID>.r2.cloudflarestorage.com
endpoint = ""
bucket = ""
access_key_id = ""
secret_access_key = ""
# 可选：STS 临时凭证
# session_token = ""
# R2 通常使用 "auto"
region = "auto"
# 可选：对象前缀，例如 "mirror"
prefix = ""
# R2 建议启用 path-style
path_style = true
# 预签名链接过期时间（秒）
expires_seconds = 900

# Auto-update settings
[update]
interval_minutes = 10
enabled = true

# Claude Code mirror configuration
[claude_code]
enabled = true
tags = ["stable", "latest"]
platforms = [
    "darwin-x64",
    "darwin-arm64",
    "linux-x64",
    "linux-arm64",
    "linux-x64-musl",
    "linux-arm64-musl",
    "win32-x64"
]
# Upstream URL (default: official GCS bucket)
# upstream_url = "https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"

# Codex mirror configuration
[codex]
enabled = true
tags = ["stable", "latest"]
# If true, "latest" will include prereleases. "stable" always excludes prereleases.
include_prerelease = false
repo = "openai/codex"
platforms = [
    "darwin-x64",
    "darwin-arm64",
    "linux-x64",
    "linux-arm64",
    "linux-x64-musl",
    "linux-arm64-musl",
    "win32-x64",
    "win32-arm64"
]

# Gemini CLI mirror configuration
[gemini]
enabled = true
tags = ["stable", "latest"]
include_prerelease = false
repo = "google-gemini/gemini-cli"

# Installer binary mirror configuration (local cache)
[installer]
enabled = true
tags = ["latest"]
platforms = [
    "darwin-x64",
    "darwin-arm64",
    "linux-x64",
    "linux-arm64",
    "linux-x64-musl",
    "linux-arm64-musl",
    "win32-x64",
    "win32-arm64"
]

# Node.js runtime mirror configuration (local cache)
[node]
enabled = true
tags = ["latest"]
platforms = [
    "darwin-x64",
    "darwin-arm64",
    "linux-x64",
    "linux-arm64",
    "win32-x64",
    "win32-arm64"
]

# node-pty prebuilds mirror configuration (local cache)
[node_pty]
enabled = true
tags = ["latest"]
platforms = [
    "darwin-x64",
    "darwin-arm64",
    "linux-x64",
    "linux-arm64",
    "linux-x64-musl",
    "linux-arm64-musl",
    "win32-x64",
    "win32-arm64"
]
